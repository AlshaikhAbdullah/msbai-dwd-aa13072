# Copy this into Streamlit Community Cloud → App → Settings → Secrets.
# Paste your service-account key fields under [gcp_service_account].
# data.py reads this when running on Streamlit Cloud (no ADC there); locally it
# uses Application Default Credentials and ignores this file.

[gcp_service_account]
type = "service_account"
project_id = "msbai-dwd-aa13072"
private_key_id = "..."
private_key = "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
client_email = "claude-agent@msbai-dwd-aa13072.iam.gserviceaccount.com"
client_id = "..."
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "..."
